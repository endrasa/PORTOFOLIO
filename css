:root{
  --navy:#071426;--navy2:#0b1e35;--blue:#1688e8;--electric:#27b9ff;
  --ink:#102238;--muted:#65758a;--line:#dce5ee;--soft:#f4f8fc;--white:#fff;
  --shadow:0 20px 55px rgba(10,34,61,.10);--radius:22px
}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;color:var(--ink);font-family:Inter,Arial,sans-serif;background:#fff;line-height:1.65}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:
radial-gradient(circle at 85% 8%,rgba(39,185,255,.08),transparent 26%),
radial-gradient(circle at 5% 45%,rgba(22,136,232,.05),transparent 28%)}
a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}
.container{width:min(1180px,calc(100% - 40px));margin:auto}
.navbar{position:fixed;top:0;left:0;right:0;z-index:100;border-bottom:1px solid rgba(220,229,238,.7);background:rgba(255,255,255,.88);backdrop-filter:blur(18px)}
.nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:-.03em}.brand-mark{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,var(--navy),#12375d);box-shadow:0 8px 20px rgba(7,20,38,.18)}
.nav-links{display:flex;align-items:center;gap:25px;font-size:13px;color:#52647a}.nav-links a:hover{color:var(--blue)}
.cv-btn{padding:11px 16px;border-radius:11px;background:var(--navy);color:#fff;font-weight:700;font-size:12px}.hamb{display:none;border:0;background:none;font-size:25px;color:var(--navy)}
.hero{padding:145px 0 90px;background:linear-gradient(180deg,#f8fbfe 0%,#fff 76%)}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}
.badge{display:inline-flex;align-items:center;gap:8px;border:1px solid #cce7f7;background:#eef9ff;color:#0879b8;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:800;letter-spacing:.04em}.dot{width:7px;height:7px;border-radius:50%;background:#16b77a;box-shadow:0 0 0 4px #16b77a17}
.kicker{margin:24px 0 9px;color:var(--blue);font-size:12px;font-weight:800;letter-spacing:.14em}
h1,h2,h3{font-family:Manrope,Inter,sans-serif;line-height:1.08}h1{font-size:clamp(43px,6vw,72px);letter-spacing:-.065em;margin:0;max-width:760px;color:var(--navy)}
.hero p{max-width:670px;color:var(--muted);font-size:16px;margin:24px 0}
.actions{display:flex;gap:12px;flex-wrap:wrap}.btn{padding:13px 18px;border-radius:12px;font-size:13px;font-weight:800;border:1px solid var(--navy)}.primary{background:var(--navy);color:#fff}.secondary{color:var(--navy);background:#fff;border-color:#ccd8e4}.meta{display:flex;gap:28px;flex-wrap:wrap;margin-top:28px;color:#65758a;font-size:12px}.meta b{display:block;color:var(--ink);font-size:13px;margin-top:2px}
.hero-visual{position:relative;min-height:520px;display:grid;place-items:center}
.photo-frame{width:min(390px,80vw);height:490px;border-radius:32px;position:relative;overflow:hidden;background:#edf4fa;border:1px solid #dce7f0;box-shadow:var(--shadow)}
.photo-frame:before{content:"";position:absolute;inset:0;background:linear-gradient(145deg,rgba(39,185,255,.12),transparent 38%,rgba(7,20,38,.12));z-index:1}
.photo-frame img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
.tech-orbit{position:absolute;inset:30px -30px -30px 30px;border:1px solid #1688e820;border-radius:34px;pointer-events:none}
.tech-card{position:absolute;bottom:25px;left:5px;background:rgba(7,20,38,.94);color:#fff;border-radius:18px;padding:16px 18px;box-shadow:0 18px 40px rgba(7,20,38,.22);min-width:190px}.tech-card small{color:#9eb1c6;font-size:9px;letter-spacing:.12em}.tech-card strong{display:block;font-size:14px;margin-top:3px}.tech-card span{display:block;color:#7bd8ff;font-size:11px;margin-top:5px}
section{padding:105px 0}.section-head{max-width:700px;margin-bottom:45px}.eyebrow{font-size:11px;color:var(--blue);font-weight:800;letter-spacing:.16em}.section-head h2{font-size:clamp(32px,4vw,48px);margin:8px 0 14px;letter-spacing:-.05em}.section-head p{color:var(--muted);margin:0}
.about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:start}.about-photo{height:480px;border-radius:28px;overflow:hidden;background:var(--soft);border:1px solid var(--line)}.about-photo img{width:100%;height:100%;object-fit:cover;object-position:center top}.about-copy p{color:var(--muted)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:26px 0}.info-box{padding:17px;border:1px solid var(--line);border-radius:16px;background:#fff}.info-box small{display:block;color:#8393a5;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.info-box strong{display:block;margin-top:5px;font-size:13px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:28px}.stat{padding:20px;border-radius:17px;background:var(--soft);border:1px solid #e4edf5}.stat strong{font-family:Manrope;font-size:24px;color:var(--navy)}.stat span{display:block;color:#74859a;font-size:11px;margin-top:2px}
.skills-bg{background:#f6f9fc}.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.skill-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;transition:.25s ease;box-shadow:0 8px 25px rgba(15,39,64,.035)}.skill-card:hover,.project:hover,.cert:hover,.achievement:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.skill-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:#eaf6ff;color:var(--blue);margin-bottom:17px}.skill-card h3{margin:0 0 12px;font-size:18px}.chips{display:flex;gap:7px;flex-wrap:wrap}.chip{font-size:10px;color:#52647a;padding:7px 9px;border-radius:9px;background:#f3f7fa;border:1px solid #e2eaf1}
.timeline{position:relative;margin-left:10px;border-left:1px solid #c9d8e5;padding-left:35px}.experience{position:relative;margin-bottom:45px}.experience:before{content:"";position:absolute;width:11px;height:11px;border-radius:50%;background:var(--blue);left:-41px;top:5px;box-shadow:0 0 0 5px #e9f5fd}.exp-top{display:flex;justify-content:space-between;gap:20px;align-items:start}.exp-period{font-size:10px;color:var(--blue);font-weight:800;letter-spacing:.08em;white-space:nowrap}.experience h3{font-size:21px;margin:0 0 3px}.company{font-size:12px;color:#728399}.experience p{color:var(--muted);max-width:780px}.exp-columns{display:grid;grid-template-columns:1fr 1fr;gap:25px}.exp-columns h4{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#6c7e91;margin-bottom:8px}.exp-columns ul{margin:0;padding-left:18px;color:#68798d;font-size:12px}
.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.project{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#fff;transition:.25s}.project-cover{height:230px;background:linear-gradient(145deg,#071426,#17446e);position:relative;overflow:hidden}.project-cover:before{content:"";position:absolute;inset:25px;border:1px solid #64d8ff32;border-radius:18px;background:linear-gradient(135deg,#ffffff08,transparent);box-shadow:inset 0 0 50px #1597ff0b}.network-lines{position:absolute;inset:0;background-image:linear-gradient(30deg,transparent 48%,#46caff35 49%,transparent 50%),linear-gradient(150deg,transparent 48%,#46caff35 49%,transparent 50%);background-size:80px 80px;opacity:.6}.project-cover .mock{position:absolute;left:16%;right:16%;top:28%;height:95px;border-radius:12px;border:1px solid #6ad9ff55;background:#0b223bd9;display:grid;place-items:center;color:#9fe8ff;font-weight:800;font-size:12px;letter-spacing:.12em}.project-body{padding:23px}.project-cat{font-size:9px;color:var(--blue);font-weight:800;letter-spacing:.12em}.project h3{margin:7px 0;font-size:20px}.project p{font-size:12px;color:var(--muted)}.project-meta{display:flex;gap:6px;flex-wrap:wrap;margin:13px 0}.project-meta span{font-size:9px;padding:5px 7px;border-radius:7px;background:#f2f6fa;color:#607286}.details{font-size:11px;font-weight:800;color:var(--blue)}
.cert-grid,.achievements{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.cert,.achievement{border:1px solid var(--line);border-radius:19px;padding:20px;background:#fff;transition:.25s}.cert-img{height:150px;border-radius:13px;background:linear-gradient(135deg,#edf6fd,#fff);display:grid;place-items:center;color:#92a6b9;font-size:11px;border:1px dashed #cbd9e5}.cert h3,.achievement h3{font-size:16px;margin:15px 0 4px}.cert p,.achievement p{font-size:11px;color:var(--muted);margin:3px 0}
.gallery-wrap{background:#071426;padding:105px 0;color:#fff}.gallery-wrap .section-head p{color:#9fb0c2}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.filter{border:1px solid #ffffff19;background:#ffffff08;color:#b9c8d8;padding:8px 12px;border-radius:9px;font-size:10px;cursor:pointer}.filter.active,.filter:hover{background:#1688e8;color:#fff;border-color:#1688e8}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.gallery-item{min-height:210px;border-radius:17px;overflow:hidden;border:1px solid #ffffff12;background:linear-gradient(145deg,#0e2945,#071426);position:relative;cursor:pointer}.gallery-item .placeholder{height:100%;min-height:210px;display:grid;place-items:center;color:#71879c;font-size:11px}.gallery-caption{position:absolute;inset:auto 0 0;padding:28px 15px 14px;background:linear-gradient(transparent,#030a14);font-size:11px}.gallery-caption b{display:block;color:#fff}.gallery-caption span{color:#8fa3b8;font-size:9px}
.career{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:0}.career:before{content:"";position:absolute;top:27px;left:6%;right:6%;height:1px;background:#cddae5}.career-step{position:relative;text-align:center;padding:0 12px}.career-dot{width:14px;height:14px;border-radius:50%;margin:20px auto 22px;background:var(--blue);border:4px solid #e9f5fc;position:relative;z-index:1}.career-step small{font-size:10px;color:var(--blue);font-weight:800}.career-step h3{font-size:14px;margin:6px 0}.career-step p{font-size:10px;color:var(--muted)}
.edu{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.edu-card{padding:25px;border:1px solid var(--line);border-radius:20px;background:#fff}.edu-card h3{font-size:20px;margin:0}.edu-card p{color:var(--muted);font-size:12px}.edu-tag{display:inline-block;padding:6px 8px;border-radius:7px;background:#eef7fd;color:#0879b8;font-size:9px;font-weight:800}
.contact{background:#f5f9fc}.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:45px}.contact-list{display:grid;gap:11px;margin-top:25px}.contact-item{padding:14px 16px;border:1px solid var(--line);border-radius:13px;background:#fff}.contact-item small{display:block;color:#8494a5;font-size:9px}.contact-item strong{font-size:12px}.form{padding:25px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 10px 35px rgba(15,39,64,.05)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:grid;gap:6px;margin-bottom:13px}.field.full{grid-column:1/-1}.field label{font-size:10px;font-weight:800;color:#5f7084}.field input,.field textarea{width:100%;border:1px solid #d6e1ea;border-radius:10px;padding:12px 13px;outline:none;background:#fbfdff;font-size:12px}.field textarea{min-height:130px;resize:vertical}.field input:focus,.field textarea:focus{border-color:#5ebef1;box-shadow:0 0 0 3px #1688e812}.submit{border:0;padding:13px 18px;background:var(--navy);color:#fff;border-radius:10px;font-weight:800;font-size:12px;cursor:pointer}
footer{background:#071426;color:#8ea1b5;padding:45px 0}.footer-grid{display:flex;justify-content:space-between;gap:30px;align-items:start}.footer-brand{color:#fff}.footer-nav{display:flex;gap:18px;flex-wrap:wrap;font-size:11px}.copyright{border-top:1px solid #ffffff10;margin-top:30px;padding-top:20px;font-size:10px;display:flex;justify-content:space-between;gap:15px}
.reveal{opacity:0;transform:translateY(18px);transition:.7s ease}.reveal.visible{opacity:1;transform:none}
.modal{position:fixed;inset:0;background:#020811d9;backdrop-filter:blur(10px);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.modal-box{width:min(760px,100%);background:#fff;color:var(--ink);border-radius:22px;padding:28px;position:relative}.modal-close{position:absolute;right:18px;top:14px;border:0;background:none;font-size:25px;cursor:pointer}.modal-box h3{font-size:26px;margin:0 0 10px}.modal-box p{color:var(--muted);font-size:13px}
@media(max-width:1000px){.nav-links{display:none}.hamb{display:block}.hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr}.hero-visual{min-height:550px}.skills-grid{grid-template-columns:1fr 1fr}.cert-grid,.achievements{grid-template-columns:1fr 1fr}}
@media(max-width:680px){.container{width:min(100% - 28px,1180px)}.hero{padding-top:120px}.hero-grid{gap:30px}.photo-frame{height:420px}.hero-visual{min-height:450px}.skills-grid,.projects,.cert-grid,.achievements,.edu,.gallery{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.exp-columns,.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.career{grid-template-columns:1fr 1fr;gap:25px}.career:before{display:none}.career-dot{margin-top:5px}.footer-grid,.copyright{flex-direction:column}.nav-inner{height:68px}section{padding:75px 0}}

.qr-card{margin-top:20px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px;border:1px solid var(--line);border-radius:18px;background:#fff}.qr-card b{display:block;font-size:13px;color:var(--navy)}.qr-card span{display:block;margin-top:5px;font-size:11px;color:var(--muted);max-width:260px}.qr-card img{width:112px;height:112px;object-fit:contain;border-radius:10px;background:#fff}.contact-item strong a,.info-box strong a,.meta b a{color:inherit}.contact-item strong a:hover,.info-box strong a:hover,.meta b a:hover{color:var(--blue)}
@media(max-width:760px){.qr-card{align-items:flex-start}.qr-card img{width:92px;height:92px}}

/* ===== ENDRA V3 — BLACK / BLUE 3D MOTION SYSTEM ===== */
:root{
 --navy:#030711;--navy2:#07111f;--blue:#087cff;--electric:#00c8ff;
 --ink:#e8f2ff;--muted:#8ea2ba;--line:rgba(115,164,210,.16);--soft:#07111e;--white:#fff;
 --panel:rgba(7,17,31,.72);--panel2:rgba(11,27,47,.72);--shadow:0 25px 80px rgba(0,0,0,.42);--radius:24px;
}
html{background:#02050b;scroll-behavior:smooth}
body{background:#02050b;color:var(--ink);overflow-x:hidden;perspective:1200px}
body:before{z-index:-5;background:radial-gradient(circle at 15% 10%,rgba(0,127,255,.13),transparent 28%),radial-gradient(circle at 90% 15%,rgba(0,200,255,.11),transparent 24%),radial-gradient(circle at 50% 80%,rgba(16,77,145,.10),transparent 34%);animation:bgPulse 10s ease-in-out infinite alternate}
@keyframes bgPulse{from{opacity:.7;transform:scale(1)}to{opacity:1;transform:scale(1.08)}}
#fx-canvas{position:fixed;inset:0;z-index:-4;pointer-events:none;opacity:.65}
.cursor-glow{position:fixed;width:260px;height:260px;border-radius:50%;pointer-events:none;z-index:-2;background:radial-gradient(circle,rgba(0,174,255,.13),transparent 68%);transform:translate(-50%,-50%);filter:blur(4px)}
.navbar{border-bottom:1px solid rgba(67,139,207,.18);background:rgba(2,7,14,.68);box-shadow:0 8px 35px rgba(0,0,0,.18)}
.navbar.scrolled{background:rgba(2,7,14,.92);border-bottom-color:rgba(0,174,255,.28)}
.brand{color:#f2f8ff}.brand-mark{background:linear-gradient(145deg,#061120,#0a5ebd);box-shadow:0 0 28px rgba(0,137,255,.28),inset 0 0 20px rgba(0,200,255,.12);animation:brandFloat 4s ease-in-out infinite}
@keyframes brandFloat{50%{transform:translateY(-3px) rotateY(10deg)}}
.nav-links{color:#9cafc4}.nav-links a{position:relative}.nav-links a:after{content:"";position:absolute;left:0;right:100%;bottom:-7px;height:2px;background:linear-gradient(90deg,var(--blue),var(--electric));box-shadow:0 0 10px var(--electric);transition:.35s}.nav-links a:hover:after{right:0}.nav-links a:hover{color:#fff}
.cv-btn{background:linear-gradient(135deg,#0757ad,#009dff);box-shadow:0 0 25px rgba(0,141,255,.24);transition:.35s}.cv-btn:hover{transform:translateY(-2px);box-shadow:0 0 38px rgba(0,174,255,.42)}
.hamb{color:#dff3ff}
.hero{position:relative;background:radial-gradient(circle at 70% 35%,rgba(0,142,255,.13),transparent 30%),linear-gradient(180deg,#020711,#030914 80%,#02050b);min-height:760px;isolation:isolate}
.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}.hero:before{width:430px;height:430px;right:-160px;top:90px;border:1px solid rgba(0,183,255,.15);box-shadow:0 0 80px rgba(0,126,255,.08);animation:orbSpin 18s linear infinite}.hero:after{width:260px;height:260px;left:-130px;bottom:20px;border:1px solid rgba(0,183,255,.1);animation:orbSpin 12s linear infinite reverse}
@keyframes orbSpin{to{transform:rotate(360deg)}}
.badge{border-color:rgba(0,197,255,.25);background:rgba(0,131,255,.08);color:#67d9ff;box-shadow:0 0 25px rgba(0,157,255,.08);animation:badgePulse 3s ease-in-out infinite}.dot{background:#18d98b;box-shadow:0 0 0 4px rgba(24,217,139,.08),0 0 14px #18d98b}
@keyframes badgePulse{50%{box-shadow:0 0 32px rgba(0,177,255,.2)}}
.kicker,.eyebrow,.project-cat,.exp-period{color:#4bcfff;text-shadow:0 0 16px rgba(0,184,255,.25)}
h1,h2,h3{color:#f2f8ff}h1{background:linear-gradient(100deg,#fff 10%,#b7e9ff 50%,#4dbfff 90%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 35px rgba(0,160,255,.12)}
.hero p,.section-head p,.about-copy p,.experience p,.project p{color:#93a8bf}
.btn{border-color:rgba(83,151,214,.25);transition:.35s;position:relative;overflow:hidden}.btn:before,.cv-btn:before{content:"";position:absolute;inset:-80% -30%;background:linear-gradient(110deg,transparent 40%,rgba(255,255,255,.3) 50%,transparent 60%);transform:translateX(-70%);transition:.7s}.btn:hover:before,.cv-btn:hover:before{transform:translateX(70%)}.primary{background:linear-gradient(135deg,#0759b4,#00a6ff);border-color:#0799ff;box-shadow:0 0 30px rgba(0,143,255,.22)}.primary:hover{transform:translateY(-3px) scale(1.01);box-shadow:0 0 45px rgba(0,174,255,.36)}.secondary{background:rgba(255,255,255,.025);color:#d9ebff;border-color:rgba(91,145,193,.28)}.secondary:hover{transform:translateY(-3px);background:rgba(0,131,255,.08);border-color:#178fff}
.meta{color:#7e94ac}.meta b{color:#eaf5ff}
.hero-visual{transform-style:preserve-3d}.photo-frame{background:#06101d;border-color:rgba(58,143,214,.25);box-shadow:0 30px 100px rgba(0,0,0,.55),0 0 50px rgba(0,132,255,.12);transform-style:preserve-3d;animation:photoFloat 5s ease-in-out infinite;transition:transform .2s ease-out}.photo-frame:after{content:"";position:absolute;inset:0;border:1px solid rgba(0,200,255,.25);border-radius:32px;box-shadow:inset 0 0 45px rgba(0,128,255,.12);pointer-events:none}.photo-frame:before{background:linear-gradient(145deg,rgba(0,187,255,.12),transparent 36%,rgba(0,0,0,.38));mix-blend-mode:screen}.tech-orbit{border-color:rgba(0,183,255,.2);box-shadow:0 0 45px rgba(0,146,255,.08);animation:orbitPulse 4s ease-in-out infinite;transform:translateZ(-30px)}
@keyframes photoFloat{50%{transform:translateY(-9px) rotateX(1deg) rotateY(-2deg)}}
@keyframes orbitPulse{50%{transform:translateZ(-30px) scale(1.025);opacity:.7}}
.tech-card{background:rgba(3,12,23,.88);border:1px solid rgba(0,184,255,.18);box-shadow:0 25px 55px rgba(0,0,0,.45),0 0 30px rgba(0,143,255,.12);backdrop-filter:blur(12px);animation:cardFloat 4s ease-in-out infinite}.tech-card span{color:#52d8ff}.tech-card small{color:#7590aa}
@keyframes cardFloat{50%{transform:translateY(-7px) translateZ(25px)}}
section{background:transparent}section:nth-of-type(even){background:linear-gradient(180deg,rgba(5,13,24,.35),rgba(2,7,14,.2))}.skills-bg{background:linear-gradient(180deg,#040b15,#06101c)!important}
.section-head h2{color:#f2f8ff;text-shadow:0 0 28px rgba(0,155,255,.08)}
.about-photo,.info-box,.stat,.skill-card,.project,.cert,.achievement,.edu-card,.contact-item,.contact-form,.qr-card{background:linear-gradient(145deg,rgba(11,27,47,.72),rgba(4,11,20,.86));border-color:rgba(91,151,206,.16);box-shadow:0 20px 55px rgba(0,0,0,.28);backdrop-filter:blur(12px)}
.about-photo{box-shadow:0 30px 80px rgba(0,0,0,.42),0 0 40px rgba(0,131,255,.1);transform-style:preserve-3d;transition:transform .25s}.about-photo:hover{transform:rotateY(-5deg) rotateX(2deg) translateY(-5px)}
.info-box:hover,.stat:hover,.skill-card:hover,.project:hover,.cert:hover,.achievement:hover,.edu-card:hover,.contact-item:hover,.qr-card:hover{transform:translateY(-9px) rotateX(2deg);border-color:rgba(0,183,255,.38);box-shadow:0 25px 70px rgba(0,0,0,.42),0 0 35px rgba(0,140,255,.12)}
