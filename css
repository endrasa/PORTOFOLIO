/* =========================================
   FEATURED PROJECTS - IMAGE ONLY
   16:9 RESPONSIVE
========================================= */

.projects .project-cover.image-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: hidden;
    position: relative;
    padding: 0;
}

/* Gambar project */
.projects .project-cover.image-cover img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
}

/* Overlay gambar */
.projects .project-cover.image-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(0, 10, 20, 0.05),
        rgba(0, 10, 20, 0.30)
    );
    pointer-events: none;
}

/* Efek hover hanya gambar */
.projects .project:hover .project-cover.image-cover img {
    transform: scale(1.04);
    filter: brightness(1.05);
}

/* Mobile */
@media (max-width: 700px) {
    .projects .project-cover.image-cover {
        aspect-ratio: 16 / 9;
        height: auto !important;
    }

    .projects .project-cover.image-cover img {
        height: 100%;
        object-fit: cover;
    }
}
